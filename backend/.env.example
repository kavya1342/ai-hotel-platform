# Application
APP_NAME=AI Hotel Operations API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=ai_hotel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy / AsyncPG
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_postgres_password@localhost:5432/ai_hotel

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Initial Manager
INITIAL_MANAGER_NAME=Hotel Manager
INITIAL_MANAGER_EMAIL=manager@example.com
INITIAL_MANAGER_PASSWORD=replace_with_secure_password

# Gemini
GEMINI_API_KEY=replace_with_gemini_api_key

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174